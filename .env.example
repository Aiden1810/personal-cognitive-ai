# Copy to .env.local for local AI chat. Never commit a real API key.
# The server route is disabled in production until login and abuse protection exist.
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Optional, server-only local Browser Use service address (default shown below).
# It reuses LLM_API_KEY/LLM_MODEL; the local service token is generated automatically.
# BROWSER_AGENT_URL=http://127.0.0.1:8001

# Supabase project URL and publishable key. These are safe for browser use.
# Cloud backup is explicit; the app does not automatically upload local data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
